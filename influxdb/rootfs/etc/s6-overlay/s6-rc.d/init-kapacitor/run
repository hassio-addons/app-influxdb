#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: InfluxDB
# Configures Kapacitor
# ==============================================================================
declare bind_address
declare log_level

# Only listen on all interfaces when the API port is exposed by the user
bind_address="127.0.0.1"
if bashio::var.has_value "$(bashio::app.port 9092)"; then
    bashio::log.info "Exposing the Kapacitor HTTP API on port 9092"
    bind_address="0.0.0.0"
fi

# Find the matching Kapacitor log level
log_level="ERROR"
if bashio::config.has_value 'log_level'; then
    case "$(bashio::string.lower "$(bashio::config 'log_level')")" in
        all|trace|debug)
            log_level="DEBUG"
            ;;
        info|notice)
            log_level="INFO"
            ;;
        warning)
            log_level="WARN"
            ;;
        error|fatal)
            log_level="ERROR"
            ;;
        off)
            log_level="OFF"
            ;;
    esac
fi

bashio::var.json \
    bind_address "${bind_address}" \
    log_level "${log_level}" \
    reporting "^$(bashio::config 'reporting')" \
    secret "$(</data/secret)" \
    | tempio \
        -template /etc/kapacitor/templates/kapacitor.gtpl \
        -out /etc/kapacitor/kapacitor.conf
