#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: InfluxDB
# Ensure a user for Chronograf & Kapacitor exists within InfluxDB
# ==============================================================================
declare influxd_pid
declare secret

# If secret file exists, skip this script
if bashio::fs.file_exists "/data/secret"; then
    exit 0
fi

secret=$(openssl rand -hex 32)

# Start a temporary InfluxDB, with authentication disabled, to create the users
INFLUXDB_HTTP_AUTH_ENABLED=false influxd > /dev/null 2>&1 &
influxd_pid=$!

bashio::log.info "Waiting for InfluxDB to come up to create the users..."
for _ in {1..60}; do
    if influx -execute "SHOW DATABASES" > /dev/null 2>&1; then
        break
    fi
    sleep 2
done

if ! influx -execute "SHOW DATABASES" > /dev/null 2>&1; then
    kill "${influxd_pid}" 2> /dev/null || true
    bashio::exit.nok "InfluxDB did not come up, unable to create the users."
fi

for user in chronograf kapacitor; do
    # The user may already exist when the secret was lost
    influx -execute "CREATE USER ${user} WITH PASSWORD '${secret}'" \
        > /dev/null 2>&1 || true
    influx -execute "SET PASSWORD FOR ${user} = '${secret}'" > /dev/null
    influx -execute "GRANT ALL PRIVILEGES TO ${user}" > /dev/null
done

# Stop the temporary InfluxDB and wait for it to release the data directory
kill "${influxd_pid}"
wait "${influxd_pid}" || true

# Save secret for future use
echo "${secret}" > /data/secret
