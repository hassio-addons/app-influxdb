#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Home Assistant Community App: InfluxDB
# Runs the Kapacitor Server
# ==============================================================================
declare secret

secret=$(</data/secret)

# Wait for InfluxDB to accept our credentials
bashio::net.wait_for 8086 localhost 900
bashio::log.info "Kapacitor is waiting until InfluxDB is available..."
for _ in {1..60}; do
    if influx \
        -execute "SHOW DATABASES" \
        -username "kapacitor" \
        -password "${secret}" \
        > /dev/null 2>&1; then
        break
    fi
    sleep 2
done

bashio::log.info 'Starting the Kapacitor'

# Run Kapacitor
exec kapacitord
